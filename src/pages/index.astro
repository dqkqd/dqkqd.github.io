---
import "../styles/global.css";
import BlogCard from "../components/BlogCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSortedBlogs } from "../lib/blog.ts";

const blogs = await getSortedBlogs();
---

<BaseLayout>
  <h1 class="mb-4 text-xl font-bold">Recent posts</h1>
  <div class="space-y-4">
    {blogs.map((blog) => <BlogCard {...blog.data} href={blog.href} />)}
  </div>
</BaseLayout>
