---
import { render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getStaticBlogs, type BlogEntry } from "../../lib/blog.ts";

export async function getStaticPaths() {
  return await getStaticBlogs();
}

interface Props {
  blog: BlogEntry;
  prevBlog: BlogEntry | undefined;
  nextBlog: BlogEntry | undefined;
}

const { blog, nextBlog, prevBlog } = Astro.props;
const { Content } = await render(blog);
---

<BlogLayout {...blog.data} nextBlog={nextBlog} prevBlog={prevBlog}>
  <Content />
</BlogLayout>
