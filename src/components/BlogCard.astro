---
interface Props {
  title: string;
  pubDatetime: Date;
  href: string;
}

const { title, pubDatetime, href } = Astro.props;

const formattedDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "2-digit",
  year: "numeric",
}).format(new Date(pubDatetime));
---

<div class="grid grid-cols-[auto_1fr] items-baseline gap-3">
  <time class="text-lg text-gray-400 tabular-nums">
    {formattedDate}
  </time>

  <a href={href} class="link">
    {title}
  </a>
</div>
