---
import "../styles/global.css";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  pubDatetime: Date;
}

const { title, pubDatetime: pubDate } = Astro.props;
---

<BaseLayout title={title}>
  <main class="prose prose-lg mx-auto px-4 sm:px-6">
    <h1>{title}</h1>
    <slot />
  </main>
  <p>Written on: {pubDate}</p>
</BaseLayout>
