---
import "../styles/global.css";
import BaseLayout from "./BaseLayout.astro";
import BlogFooter from "../components/BlogFooter.astro";
import BlogMeta from "../components/BlogMeta.astro";
import type { BlogEntry } from "../lib/blog";

interface Props {
  title: string;
  description: string;
  tags: string[];
  nextBlog: BlogEntry | undefined;
  prevBlog: BlogEntry | undefined;
}

const { title, description, tags, nextBlog, prevBlog } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="prose prose-lg">
    <h1>{title}</h1>
    <slot />
  </article>
  <BlogMeta tags={tags} />
  <BlogFooter nextBlog={nextBlog} prevBlog={prevBlog} />
</BaseLayout>
