---
import "../styles/global.css";
import BaseLayout from "./BaseLayout.astro";
import type { BlogEntry } from "../lib/blog";

interface Props {
  title: string;
  description: string;
  nextBlog: BlogEntry | undefined;
  prevBlog: BlogEntry | undefined;
}

const { title, description, nextBlog, prevBlog } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="prose prose-lg mx-auto px-4 sm:px-6">
    <h1>{title}</h1>
    <slot />
  </article>

  <footer class="mt-16 border-t border-zinc-200">
    <div
      class="mx-auto flex max-w-prose items-center justify-between gap-4 px-4 py-8 text-sm sm:px-6"
    >
      <div class="flex-1">
        {
          prevBlog && (
            <a href={prevBlog.href} class="link group flex flex-col">
              <span class="mb-1 text-lg tracking-wide">← Previous</span>
              <span>{prevBlog.data.title}</span>
            </a>
          )
        }
      </div>
      <div class="flex-1 text-right">
        {
          nextBlog && (
            <a href={nextBlog.href} class="link group flex flex-col items-end">
              <span class="mb-1 text-lg tracking-wide">Next →</span>
              <span>{nextBlog.data.title}</span>
            </a>
          )
        }
      </div>
    </div>
  </footer>
</BaseLayout>
