---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Head from "../components/Head.astro";
import { SITE } from "../site";

interface Props {
  title?: string;
  description?: string;
}

const defaultTitleAndDescription = `${SITE.name}'s blog`;
const {
  title = defaultTitleAndDescription,
  description = defaultTitleAndDescription,
} = Astro.props;
---

<html lang="en">
  <Head title={title} description={description} />
  <body>
    <main class="mx-auto max-w-2xl px-4">
      <NavBar />
      <slot />
    </main>
  </body>
</html>
