---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <main class="mx-auto max-w-2xl px-4">
      <NavBar />
      <slot />
    </main>
  </body>
</html>
